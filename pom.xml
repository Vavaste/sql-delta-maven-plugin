<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>io.github.vavaste</groupId>
	<artifactId>sql-delta-maven-plugin</artifactId>
	<version>0.1.0-SNAPSHOT</version>
	<packaging>maven-plugin</packaging>

	<name>sql-delta-maven-plugin</name>
	<description>Drafts the next SQL migration from the differences between the JPA/Hibernate entities of a project and a live database, for any migration tool.</description>
	<url>https://github.com/Vavaste/sql-delta-maven-plugin</url>
	<inceptionYear>2026</inceptionYear>

	<licenses>
		<license>
			<name>Apache-2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<developer>
			<id>vavaste</id>
			<name>Vavaste</name>
			<url>https://github.com/Vavaste</url>
		</developer>
	</developers>

	<scm>
		<connection>scm:git:https://github.com/Vavaste/sql-delta-maven-plugin.git</connection>
		<developerConnection>scm:git:git@github.com:Vavaste/sql-delta-maven-plugin.git</developerConnection>
		<url>https://github.com/Vavaste/sql-delta-maven-plugin</url>
		<tag>HEAD</tag>
	</scm>

	<issueManagement>
		<system>GitHub Issues</system>
		<url>https://github.com/Vavaste/sql-delta-maven-plugin/issues</url>
	</issueManagement>

	<prerequisites>
		<maven>3.9.0</maven>
	</prerequisites>

	<properties>
		<maven.compiler.release>17</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<project.build.outputTimestamp>2026-11-18T00:00:00Z</project.build.outputTimestamp>

		<!-- Maven API: the lowest supported Maven, it becomes requiredMavenVersion in the descriptor -->
		<maven.api.version>3.9.0</maven.api.version>
		<maven-plugin-tools.version>3.16.0</maven-plugin-tools.version>

		<!-- The versions the engine is compiled and tested against: keep them equal to the defaults of the
		     liquibaseVersion and liquibaseHibernateVersion parameters (AbstractSqlDeltaMojo), which the user's build
		     resolves at run time. liquibase-core 4.33.0 is the last Apache-2.0 release; 5.x is FSL-1.1-ALv2. The
		     extension 5.0.4 is Apache-2.0 and is the first line that converges on core 4.32+. -->
		<liquibase.version>4.33.0</liquibase.version>
		<liquibase-hibernate.version>5.0.4</liquibase-hibernate.version>

		<!-- Hibernate/Spring stack the engine is compiled and tested against: Spring Boot 4 / Hibernate 7 by default,
		     the hibernate6 profile below switches to Spring Boot 3 / Hibernate 6. These are plain properties rather
		     than an activeByDefault profile, which Maven would drop as soon as -Prelease or any other profile is on. -->
		<spring-boot.version>4.0.9</spring-boot.version>
		<spring.version>7.0.10</spring.version>
		<hibernate.version>7.2.25.Final</hibernate.version>
		<liquibase-hibernate.artifactId>liquibase-hibernate7</liquibase-hibernate.artifactId>
		<!-- brings SpringImplicitNamingStrategy, which the engine looks for to pick Spring Boot's naming strategies:
		     for the naming tests and the schemas the tests create -->
		<spring-boot-naming.artifactId>spring-boot-hibernate</spring-boot-naming.artifactId>

		<slf4j.version>2.0.17</slf4j.version>

		<postgresql.version>42.7.14</postgresql.version>
		<h2.version>2.4.240</h2.version>
		<junit.version>5.14.4</junit.version>
		<assertj.version>3.27.7</assertj.version>
		<testcontainers.version>2.0.3</testcontainers.version>
		<!-- the PostgreSQL of the Testcontainers tests; -Dsqldelta.test.postgres.image=postgres:15 runs them on another -->
		<sqldelta.test.postgres.image>postgres:18.3-trixie</sqldelta.test.postgres.image>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.apache.maven</groupId>
				<artifactId>maven</artifactId>
				<version>${maven.api.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.junit</groupId>
				<artifactId>junit-bom</artifactId>
				<version>${junit.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<!-- ===== Maven side (plugin realm) ===== -->
		<dependency>
			<groupId>org.apache.maven</groupId>
			<artifactId>maven-plugin-api</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.maven</groupId>
			<artifactId>maven-core</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.maven.resolver</groupId>
			<artifactId>maven-resolver-api</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.maven.plugin-tools</groupId>
			<artifactId>maven-plugin-annotations</artifactId>
			<version>${maven-plugin-tools.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>javax.inject</groupId>
			<artifactId>javax.inject</artifactId>
			<version>1</version>
			<scope>provided</scope>
		</dependency>

		<!-- ===== Engine side (compiled here, loaded only by the isolated engine class loader at run time) =====
		     Everything below is provided: the plugin jar contains none of it. At run time the engine sees the
		     project's own Hibernate/Spring/JDBC driver and the Liquibase artifacts resolved by AbstractSqlDeltaMojo. -->
		<dependency>
			<groupId>org.liquibase</groupId>
			<artifactId>liquibase-core</artifactId>
			<version>${liquibase.version}</version>
			<scope>provided</scope>
			<exclusions>
				<exclusion>
					<groupId>info.picocli</groupId>
					<artifactId>picocli</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.liquibase.ext</groupId>
			<artifactId>${liquibase-hibernate.artifactId}</artifactId>
			<version>${liquibase-hibernate.version}</version>
			<scope>provided</scope>
			<!-- never the extension's own Hibernate: the project's Hibernate is the only one -->
			<exclusions>
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.hibernate.orm</groupId>
			<artifactId>hibernate-core</artifactId>
			<version>${hibernate.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<version>${slf4j.version}</version>
			<scope>provided</scope>
		</dependency>

		<!-- ===== Tests ===== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>${spring-boot-naming.artifactId}</artifactId>
			<version>${spring-boot.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-orm</artifactId>
			<version>${spring.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<version>${postgresql.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<version>${h2.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<version>${assertj.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<version>${testcontainers.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<version>${testcontainers.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>3.15.0</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-resources-plugin</artifactId>
					<version>3.5.0</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-jar-plugin</artifactId>
					<version>3.5.1</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-install-plugin</artifactId>
					<version>3.1.4</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>3.5.6</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-source-plugin</artifactId>
					<version>3.4.0</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-javadoc-plugin</artifactId>
					<version>3.12.0</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-gpg-plugin</artifactId>
					<version>3.2.8</version>
				</plugin>
				<plugin>
					<groupId>org.sonatype.central</groupId>
					<artifactId>central-publishing-maven-plugin</artifactId>
					<version>0.12.0</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-plugin-plugin</artifactId>
					<version>${maven-plugin-tools.version}</version>
				</plugin>
				<!-- the release workflow sets the tagged version with versions:set -->
				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>versions-maven-plugin</artifactId>
					<version>2.25.2</version>
				</plugin>
			</plugins>
		</pluginManagement>

		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-plugin-plugin</artifactId>
				<configuration>
					<goalPrefix>sql-delta</goalPrefix>
					<helpPackageName>io.github.vavaste.sqldelta</helpPackageName>
				</configuration>
				<executions>
					<execution>
						<id>help-mojo</id>
						<goals>
							<goal>helpmojo</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<systemPropertyVariables>
						<sqldelta.test.postgres.image>${sqldelta.test.postgres.image}</sqldelta.test.postgres.image>
					</systemPropertyVariables>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- Maven Central release: ./mvnw versions:set -DnewVersion=<version>, then ./mvnw -Prelease deploy, with
		     MAVEN_GPG_KEY and MAVEN_GPG_PASSPHRASE in the environment and a <server> with id central holding a
		     Portal user token -->
		<profile>
			<id>release</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-source-plugin</artifactId>
						<executions>
							<execution>
								<id>attach-sources</id>
								<goals>
									<goal>jar-no-fork</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-javadoc-plugin</artifactId>
						<configuration>
							<doclint>all,-missing</doclint>
						</configuration>
						<executions>
							<execution>
								<id>attach-javadocs</id>
								<goals>
									<goal>jar</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<!-- the bc signer reads the armored key from MAVEN_GPG_KEY: no gpg binary or keyring needed -->
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<configuration>
							<signer>bc</signer>
							<bestPractices>true</bestPractices>
						</configuration>
						<executions>
							<execution>
								<id>sign-artifacts</id>
								<phase>verify</phase>
								<goals>
									<goal>sign</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.sonatype.central</groupId>
						<artifactId>central-publishing-maven-plugin</artifactId>
						<extensions>true</extensions>
						<configuration>
							<publishingServerId>central</publishingServerId>
							<autoPublish>true</autoPublish>
							<waitUntil>published</waitUntil>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!-- Spring Boot 3 / Hibernate 6: ./mvnw verify -Phibernate6 compiles and tests the engine on Hibernate 6.6 -->
		<profile>
			<id>hibernate6</id>
			<properties>
				<spring-boot.version>3.5.16</spring-boot.version>
				<spring.version>6.2.19</spring.version>
				<hibernate.version>6.6.53.Final</hibernate.version>
				<liquibase-hibernate.artifactId>liquibase-hibernate6</liquibase-hibernate.artifactId>
				<spring-boot-naming.artifactId>spring-boot-autoconfigure</spring-boot-naming.artifactId>
			</properties>
		</profile>
	</profiles>
</project>
